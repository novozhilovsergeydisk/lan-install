#!/bin/bash
set -e

# Защита от запуска на сервере
if [ "$(uname -s)" != "Darwin" ]; then
    echo "🛑 Ошибка безопасности: Этот скрипт предназначен для запуска ТОЛЬКО на локальной машине разработчика (macOS)."
    exit 1
fi

# Цвета для вывода
LOGFILE="$HOME/logs/git-deploy.log"
PROJECT_DIR="$(pwd)"
TIMESTAMP=$(date "+%Y-%m-%d %T")
SERVER_PATH="lan-install-new"           # .67, боевой сервер (прямой доступ, без ProxyJump через .10)
REMOTE_DIR="/var/www/lan-install"
REMOTE_USER="www-data"                   # владелец .git и storage/ на сервере; SSH-ключ для GitHub
                                          # (deploy-key) настроен в core.sshCommand репозитория на сервере

# === Цвета для вывода ===
GREEN='\033[32m'
BLUE='\033[34m'
YELLOW='\033[33m'
RED='\033[31m'
NC='\033[0m' # No Color

# === Логирование и вывод в терминал ===
log() {
  local level="$1"
  local message="$2"
  echo -e "$(date "+%Y-%m-%d %T") [$level] $message" | tee -a "$LOGFILE"
}

info() {
  echo -e "${BLUE}[*] $1${NC}" | tee -a "$LOGFILE"
}
success() {
  echo -e "${GREEN}[✓] $1${NC}" | tee -a "$LOGFILE"
}
warn() {
  echo -e "${YELLOW}[!] $1${NC}" | tee -a "$LOGFILE"
}
error() {
  echo -e "${RED}[✗] $1${NC}" | tee -a "$LOGFILE"
}

# === Проверка аргументов ===
if [ -z "$1" ]; then
  warn "Не указан комментарий для коммита."
  echo -e "Использование: ${YELLOW}$0 \"Ваш комментарий\"${NC}"
  exit 1
fi

COMMENT="$1"

# === Начало работы ===
mkdir -p "$(dirname "$LOGFILE")"
log "INFO" "Запуск git-deploy с комментарием: '$COMMENT'"

cd "$PROJECT_DIR" || { error "Не удалось перейти в директорию проекта"; exit 1; }

set -e  # Прерывать при ошибке

# === Git: status → add → commit → push ===
info "Проверяем статус репозитория..."
git status

info "Добавляем изменения..."
git add .

info "Делаем коммит..."
# Коммит может быть уже сделан вручную — тогда commit вернёт ненулевой код,
# и из-за set -e скрипт прервался бы до push и обновления сервера.
git commit -m "$COMMENT" || warn "Нечего коммитить — продолжаем с тем, что уже зафиксировано"

info "Выполняем git push..."
git push

LOCAL_COMMIT=$(git rev-parse --short HEAD)

# === Удалённое обновление на сервере ===
info "Обновляем проект на сервере ($SERVER_PATH)..."
ssh "$SERVER_PATH" "
  cd $REMOTE_DIR &&
  sudo -u $REMOTE_USER git pull &&
  sudo -u $REMOTE_USER php $REMOTE_DIR/artisan config:clear &&
  sudo -u $REMOTE_USER php $REMOTE_DIR/artisan cache:clear &&
  sudo -u $REMOTE_USER php $REMOTE_DIR/artisan view:clear &&
  sudo -u $REMOTE_USER php $REMOTE_DIR/artisan route:clear
" || {
  error "Ошибка при обновлении на сервере"
  exit 1
}

# === Сверка коммита на сервере (чтобы не повторить инцидент 26.07 — код "уехал не туда") ===
info "Проверяем версию кода на сервере..."
REMOTE_COMMIT=$(ssh "$SERVER_PATH" "cd $REMOTE_DIR && sudo -u $REMOTE_USER git rev-parse --short HEAD")

if [ "$LOCAL_COMMIT" != "$REMOTE_COMMIT" ]; then
  error "Коммит на сервере ($REMOTE_COMMIT) не совпадает с локальным ($LOCAL_COMMIT)!"
  exit 1
fi

success "Сервер обновлён до коммита $REMOTE_COMMIT ✓"

# === Завершение ===
success "✅ Все операции успешно завершены!"
